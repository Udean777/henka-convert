    "gifenc": "^1.0.3",
    "heic-to": "^1.6.5",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "turndown": "^7.2.4",
    "utif2": "^4.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
